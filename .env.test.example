# Copy to .env.test (gitignored). Same values as .env.local — only the
# DATABASE_URL points at a separate `inventory_test` database so tests
# can wipe rows without touching dev data.
#
# One-time setup:
#   createdb inventory_test
#   pnpm db:push:test
#
# After that, `pnpm test` runs against this DB. To apply schema changes
# to both dev and test in one shot, use `pnpm db:push:all`.

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/inventory_test"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-me-32-chars-minimum
RESEND_API_KEY=re_replace_me
APP_URL=http://localhost:3000
EMAIL_FROM="Inventory Management <noreply@fidexa.org>"
