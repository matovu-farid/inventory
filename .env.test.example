# Copy this to .env.test (gitignored) and create the test database first:
#
#   createdb inventory_test
#   pnpm dotenv -e .env.test -- pnpm db:push
#
# Then run integration tests with:
#
#   pnpm test:integration
#
# These tests wipe the user/session/account/verification tables on every test
# run, which is why they must point at a SEPARATE database from your dev DB.

DATABASE_URL=postgresql://faridmatovu:alphanew90@127.0.0.1:5432/inventory_test
BETTER_AUTH_SECRET=test-secret-replace-me
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Email keys not actually called (sends are mocked) but env validation still runs:
RESEND_API_KEY=re_test_dummy
EMAIL_FROM="Inventory Management <noreply@fidexa.org>"
